# ── Como gerar o password_hash ────────────────────────────────────────────────
# Execute em qualquer terminal Python:
#
#   import bcrypt
#   print(bcrypt.hashpw(b"sua-senha-aqui", bcrypt.gensalt(12)).decode())
#
# Cole o resultado em password_hash acima.
